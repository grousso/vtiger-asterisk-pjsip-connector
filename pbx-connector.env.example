# Copy to /etc/pbx-connector.env, edit, and protect it:
#   chmod 600 /etc/pbx-connector.env
# Used by both systemd services (see systemd/).

# ---- Asterisk Manager Interface (both services) ----
AMI_HOST=127.0.0.1
AMI_PORT=5038
AMI_USER=vtiger
AMI_PASS=change-me

# ---- vtiger_pbx_monitor.py ----
# Full URL of crm-endpoint/pbx.php on your vtiger server
PBX_API_URL=https://crm.example.com/pbx-endpoint/pbx.php
# Must equal 'api_secret' in crm-endpoint/config.php  (openssl rand -hex 32)
PBX_API_SECRET=change-me
# Optional: extension -> vtiger user id. Leave {} to match users by their
# "CRM Phone Extension" field in vtiger instead.
PBX_EXTENSION_MAP={}
# Where the log file and the retry queue are written
PBX_DATA_DIR=/var/lib/pbx-connector
# Seconds to wait for all legs of a ring-group call before logging it
PBX_GROUP_WINDOW_SECONDS=3

# ---- click2call.py ----
# Must equal "Vtiger Secret Key" in vtiger Settings -> PBXManager
CLICK2CALL_SECRET=change-me
CLICK2CALL_CONTEXT=from-internal
CLICK2CALL_LISTEN_HOST=0.0.0.0
CLICK2CALL_LISTEN_PORT=5000
